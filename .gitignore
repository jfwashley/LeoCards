!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# playwright
/playwright-report/
/test-results/

# habitat video render intermediates (frames are regenerated; final clips committed)
/e2e/scripts/.tmp/

# claude
.claude/

.vercel

# local credentials — never commit
.github/token/

# throwaway run outputs
.playwright-full-run.log
.preview-url.tmp
.planning/dev-server.log
.e2e-dev.log

# Phase 15 QA harness — generated resumable-session manifests (QAJ-03)
scripts/qa-manifest-*.json
scripts/qa-manifest.json
